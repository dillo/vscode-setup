{
  // ---------------------------------------------------------------
  // Ruby Focus: Ruby without assistance.
  // Layered on core.jsonc + ruby.jsonc (see BASES in sync.py), so file
  // associations, excludes, and indentation match the Ruby profile.
  // Extensions come from ruby-focus-extensions.txt, not the core toolbelt,
  // so no language servers, linters, or formatters load here.
  // Toggle with ctrl+alt+cmd+f (keybindings.json in the default profile).
  // ---------------------------------------------------------------

  // Completion: nothing pops up unless asked for with ctrl+space.
  "editor.quickSuggestions": { "other": "off", "comments": "off", "strings": "off" },
  "editor.suggestOnTriggerCharacters": false,
  "editor.wordBasedSuggestions": "off",
  "editor.inlineSuggest.enabled": false,
  "editor.parameterHints.enabled": false,
  "emmet.showExpandedAbbreviation": "never",
  "emmet.triggerExpansionOnTab": false,

  // Inline noise: hovers, lightbulbs, code lens, inlay hints.
  "editor.hover.enabled": "off",
  "editor.lightbulb.enabled": "off",
  "editor.codeLens": false,
  "editor.inlayHints.enabled": "off",
  "editor.semanticHighlighting.enabled": false,

  // No auto-inserted characters.
  "editor.autoClosingBrackets": "never",
  "editor.autoClosingQuotes": "never",
  "editor.autoClosingComments": "never",
  "editor.autoSurround": "never",
  "html.autoClosingTags": false,

  // Nothing rewrites the file on save.
  "editor.formatOnSave": false,
  "[ruby]": { "editor.tabSize": 2 },
  "[erb]": { "editor.formatOnSave": false, "editor.tabSize": 2 },

  // Relative line numbers, so counts for Vim motions (5k, 3j) read off the gutter.
  "editor.lineNumbers": "relative",

  // Explorer and the rest of the primary side bar on the right.
  "workbench.sideBar.location": "right",
  // Terminal/output panel on the left, sharing the window with the editor.
  // Only applies where a folder has no saved panel position. Folders are
  // shared with the Ruby profile, so the panel opens wherever the last
  // profile left it. Half width is set in the profile's layout state.
  "workbench.panel.defaultLocation": "left",
  // Same font as iTerm2's Default profile, so the terminal reads the same in both.
  "terminal.integrated.fontFamily": "'MesloLGL Nerd Font Mono', Menlo, monospace",
  // iTerm2's scrollback (50,000 lines) instead of core's 10,000.
  "terminal.integrated.scrollback": 50000,
  // Marks Focus terminals; ~/.zshrc hides the p10k right prompt when set.
  "terminal.integrated.env.osx": { "VSCODE_FOCUS_PROFILE": "1" },

  // AI features: chat, Copilot, and inline AI suggestions.
  "chat.disableAIFeatures": true,
  "chat.commandCenter.enabled": false,

  // Set by vscode-icons on first launch; kept here so sync.py preserves it.
  "vsicons.dontShowNewVersionMessage": true
}
