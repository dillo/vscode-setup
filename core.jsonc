{
  // ---------------------------------------------------------------
  // Default profile: editor-wide behaviour only.
  // Language tooling lives in the Web / Ruby / Python / Java / Go
  // profiles so it is not loaded in every window.
  // ---------------------------------------------------------------

  // Appearance — matches the Neovim setup's JetBrainsMono Nerd Font.
  "workbench.colorTheme": "Catppuccin Macchiato",
  "workbench.iconTheme": "vscode-icons",
  "editor.fontFamily": "'JetBrainsMono Nerd Font', 'JetBrains Mono', Menlo, monospace",
  "editor.fontLigatures": true,
  // "editor.fontSize": 16,
  // "terminal.integrated.fontSize": 16,
  "terminal.integrated.fontFamily": "'JetBrainsMono Nerd Font', Menlo, monospace",
  "editor.codeLensFontFamily": "'JetBrainsMono Nerd Font', Menlo, monospace",
  "editor.fontWeight": "400",
  "terminal.integrated.fontWeight": "400",
  "window.zoomLevel": 1,

  // Chrome that the Neovim config also keeps out of the way.
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": false,
  "editor.stickyScroll.scrollWithEditor": false,
  "workbench.tree.enableStickyScroll": false,
  "editor.hover.sticky": false,

  // Indentation — mirrors opt.tabstop/shiftwidth = 2 with detectIndentation off.
  "editor.tabSize": 2,
  "editor.insertSpaces": true,
  "editor.detectIndentation": false,
  // Only trailing whitespace, matching listchars { trail = "·" } in Neovim.
  // "boundary" also dots every leading indent space, which is noisy.
  "editor.renderWhitespace": "trailing",
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.wordWrap": "on",
  "diffEditor.wordWrap": "on",
  "editor.cursorSurroundingLines": 8,

  // Saving and formatting.
  // "afterDelay" silently disables formatOnSave, so use onFocusChange
  // to keep parity with conform.nvim's format_on_save.
  "files.autoSave": "onFocusChange",
  "editor.formatOnSave": true,
  "editor.formatOnPaste": false,
  "files.trimTrailingWhitespace": true,
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,

  // Performance: keep the watcher and search out of build output.
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/build/**": true,
    "**/target/**": true,
    "**/.gradle/**": true,
    "**/vendor/bundle/**": true,
    "**/tmp/cache/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true,
    "**/.mypy_cache/**": true,
    "**/.ruff_cache/**": true,
    "**/.pytest_cache/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/dist": true,
    "**/build": true,
    "**/target": true,
    "**/vendor/bundle": true,
    "**/.venv": true,
    "**/__pycache__": true,
    "**/*.lock": true,
    "**/package-lock.json": true,
    "**/yarn.lock": true,
    "**/Gemfile.lock": true
  },
  "search.followSymlinks": false,
  "search.smartCase": true,

  // Git — matches the gitsigns/telescope workflow.
  "git.autofetch": true,
  "git.confirmSync": false,
  "git.enableSmartCommit": true,
  "scm.diffDecorationsGutterWidth": 3,

  // Markdown and data formats stay in the default profile.
  "[markdown]": {
    "editor.defaultFormatter": "yzhang.markdown-all-in-one",
    "editor.wordWrap": "on",
    "files.trimTrailingWhitespace": false
  },
  "[yaml]": {
    "editor.defaultFormatter": "redhat.vscode-yaml"
  },
  "[json]": { "editor.tabSize": 2 },
  "[jsonc]": { "editor.tabSize": 2 },

  // Layout: Explorer and the rest of the primary side bar on the right.
  "workbench.sideBar.location": "right",

  // Terminal.
  // Terminal/output panel on the left in every profile. Only applies where a
  // folder has no saved panel position (View: Move Panel Left fixes those).
  "workbench.panel.defaultLocation": "left",
  "terminal.integrated.scrollback": 10000,
  "terminal.integrated.defaultProfile.osx": "zsh",

  // Telemetry.
  "redhat.telemetry.enabled": false,
  "telemetry.telemetryLevel": "off",
  "docker.extension.enableComposeLanguageServer": false,

  // MCP servers migrated here from the old Java profile.
  "chat.mcp.gallery.enabled": true,

  // VSCodeVim starts off in every window; ctrl+alt+cmd+v (keybindings.json)
  // turns it on for the session.
  "vim.disableExtension": true
}
